{
  "event": "permission_request",
  "env": {},
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_run": "allowed"
  },
  "stdin": {
    "hook_event_name": "PermissionRequest",
    "tool_name": "Bash",
    "tool_input": {
      "command": "vahta run --secret API_KEY -- cargo test"
    },
    "cwd": "{{TMP}}/proj",
    "session_id": "s1"
  },
  "stdout": {
    "hookSpecificOutput": {
      "hookEventName": "PermissionRequest",
      "decision": {
        "behavior": "allow"
      }
    }
  },
  "exit": 0,
  "check_run": [
    {
      "cwd": "{{TMP}}/proj",
      "argv": [
        "cargo",
        "test"
      ],
      "names": [
        "API_KEY"
      ]
    }
  ]
}
