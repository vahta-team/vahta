{
  "event": "permission_request",
  "env": {},
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_http": "allowed"
  },
  "stdin": {
    "hook_event_name": "PermissionRequest",
    "tool_name": "Bash",
    "tool_input": {
      "command": "vahta http --secret API_KEY -H 'Authorization: Bearer {API_KEY}' -X POST -d '{\"a\": 1}' https://api.example.com/v1/items"
    },
    "cwd": "{{TMP}}/proj",
    "session_id": "s1"
  },
  "stdout": {
    "hookSpecificOutput": {
      "hookEventName": "PermissionRequest",
      "decision": {
        "behavior": "allow"
      }
    }
  },
  "exit": 0,
  "check_run": [
    {
      "cwd": "{{TMP}}/proj",
      "url": "https://api.example.com/v1/items",
      "names": [
        "API_KEY"
      ]
    }
  ]
}
