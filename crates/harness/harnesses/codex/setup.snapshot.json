{
  "setup_version": 2,
  "fragment": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|apply_patch|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness codex --event before_tool --setup 2"
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness codex --event permission_request --setup 2"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness codex --event session_start --setup 2"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness codex --event prompt --setup 2"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash|apply_patch|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness codex --event after_tool --setup 2"
            }
          ]
        }
      ]
    }
  }
}
