{
  "setup_version": 2,
  "fragment": {
    "version": 1,
    "hooks": {
      "preToolUse": [
        {
          "command": "{hook} --harness cursor --event before_tool --setup 2",
          "matcher": "Shell|Write"
        }
      ],
      "beforeMCPExecution": [
        {
          "command": "{hook} --harness cursor --event before_tool --setup 2"
        }
      ],
      "beforeReadFile": [
        {
          "command": "{hook} --harness cursor --event before_read --setup 2"
        }
      ],
      "sessionStart": [
        {
          "command": "{hook} --harness cursor --event session_start --setup 2"
        }
      ],
      "beforeSubmitPrompt": [
        {
          "command": "{hook} --harness cursor --event prompt --setup 2",
          "timeout": 120
        }
      ],
      "postToolUse": [
        {
          "command": "{hook} --harness cursor --event after_tool --setup 2"
        }
      ]
    }
  }
}
