{
  "event": "before_tool",
  "env": {
    "VAHTA_HOOK_UNVERIFIED": "1"
  },
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "stdin": {
    "hook_event_name": "preToolUse",
    "tool_name": "Shell",
    "tool_input": {
      "command": "vahta http --secret API_KEY -H 'Authorization: Bearer {API_KEY}' https://api.example.com/v1/items"
    },
    "cwd": "{{TMP}}/proj",
    "conversation_id": "c1",
    "cursor_version": "1.7.2"
  },
  "stdout": null,
  "exit": 0
}
