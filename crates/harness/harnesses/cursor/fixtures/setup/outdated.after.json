{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event session_start --setup 2"
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/validate-tool.sh",
        "matcher": "Shell"
      },
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event before_tool --setup 2",
        "matcher": "Shell|Write"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event before_tool --setup 2"
      }
    ],
    "beforeReadFile": [
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event before_read --setup 2"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event prompt --setup 2",
        "timeout": 120
      }
    ],
    "postToolUse": [
      {
        "command": "/opt/vahta/bin/vahta-hook --harness cursor --event after_tool --setup 2"
      }
    ]
  }
}
