{
  "event": "before_tool",
  "env": {
    "VAHTA_HOOK_UNVERIFIED": "1"
  },
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_run": "no_opinion"
  },
  "stdin": {
    "hook_event_name": "preToolUse",
    "tool_name": "Shell",
    "tool_input": {
      "command": "vahta run --secret API_KEY -- cargo test"
    },
    "cwd": "{{TMP}}/proj",
    "conversation_id": "c1",
    "cursor_version": "1.7.2"
  },
  "stdout": null,
  "exit": 0,
  "check_run": [
    {
      "cwd": "{{TMP}}/proj",
      "argv": [
        "cargo",
        "test"
      ],
      "names": [
        "API_KEY"
      ]
    }
  ]
}
