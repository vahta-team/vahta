{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/audit-log --pre"
          },
          {
            "type": "command",
            "command": "/home/u/.local/bin/key-amnesia-hook"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event before_tool --setup 7"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event before_read --setup 7"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event session_start --setup 7"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event session_end --setup 7"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event prompt --setup 7",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event after_tool --setup 7"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(vahta reveal:*)",
      "Bash(vahta copy:*)",
      "Bash(vahta _surface:*)",
      "Bash(vh reveal:*)",
      "Bash(vh copy:*)",
      "Bash(vh _surface:*)",
      "PowerShell(vahta reveal:*)",
      "PowerShell(vahta copy:*)",
      "PowerShell(vahta _surface:*)",
      "PowerShell(vh reveal:*)",
      "PowerShell(vh copy:*)",
      "PowerShell(vh _surface:*)"
    ],
    "allow": [
      "Bash(vahta list)",
      "Bash(vahta list --json)",
      "Bash(vahta check)",
      "Bash(vahta check --json)",
      "Bash(vh list)",
      "Bash(vh list --json)",
      "Bash(vh check)",
      "Bash(vh check --json)",
      "Bash(vahta scrub --transcript)",
      "Bash(vahta scrub --transcript --all)",
      "Bash(vahta scrub --transcript --json)",
      "Bash(vh scrub --transcript)",
      "Bash(vh scrub --transcript --all)",
      "Bash(vh scrub --transcript --json)",
      "PowerShell(vahta list)",
      "PowerShell(vahta list --json)",
      "PowerShell(vahta check)",
      "PowerShell(vahta check --json)",
      "PowerShell(vh list)",
      "PowerShell(vh list --json)",
      "PowerShell(vh check)",
      "PowerShell(vh check --json)",
      "PowerShell(vahta scrub --transcript)",
      "PowerShell(vahta scrub --transcript --all)",
      "PowerShell(vahta scrub --transcript --json)",
      "PowerShell(vh scrub --transcript)",
      "PowerShell(vh scrub --transcript --all)",
      "PowerShell(vh scrub --transcript --json)"
    ]
  }
}
