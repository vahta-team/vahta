{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/audit-log --pre"
          },
          {
            "type": "command",
            "command": "/home/u/.local/bin/key-amnesia-hook"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event before_tool --setup 2"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event before_read --setup 2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event session_start --setup 2"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event prompt --setup 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/vahta/bin/vahta-hook --harness claude --event after_tool --setup 2"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(vahta reveal:*)",
      "Bash(vahta copy:*)",
      "Bash(vahta _surface:*)",
      "Bash(vh reveal:*)",
      "Bash(vh copy:*)",
      "Bash(vh _surface:*)"
    ]
  }
}
