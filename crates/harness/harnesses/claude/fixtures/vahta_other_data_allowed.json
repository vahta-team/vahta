{
  "event": "before_read",
  "env": {
    "VAHTA_DATA_DIR": "{{TMP}}/data"
  },
  "files": {
    "proj/.vahta/vault.vht": "not a real vault\n",
    "proj/vahta.toml": "[secrets.A]\n",
    "proj/.vahta-notes/x.md": "# notes\n",
    "proj/src/main.rs": "fn main() {}\n",
    "data/journal.jsonl": "{}\n",
    "data/vaults/abc/state": "x\n",
    "other/state": "x\n"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
      "file_path": "{{TMP}}/other/state"
    },
    "cwd": "{{TMP}}/proj"
  },
  "stdout": null,
  "exit": 0
}
