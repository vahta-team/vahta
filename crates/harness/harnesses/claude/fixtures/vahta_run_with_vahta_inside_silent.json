{
  "event": "before_tool",
  "env": {},
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_run": "allowed"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "vahta run --secret API_KEY -- vahta list"
    },
    "cwd": "{{TMP}}/proj"
  },
  "stdout": null,
  "exit": 0,
  "check_run": []
}
