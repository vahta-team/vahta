{
  "event": "before_tool",
  "env": {},
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_run": "allowed"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "vahta run --vault ../tools --secret API_KEY -- cargo test"
    },
    "cwd": "{{TMP}}/proj"
  },
  "stdout": {
    "hookSpecificOutput": {
      "hookEventName": "PreToolUse",
      "permissionDecision": "allow",
      "permissionDecisionReason": "Vahta: the command is within API_KEY's approved rules"
    }
  },
  "exit": 0,
  "check_run": [
    {
      "cwd": "{{TMP}}/proj",
      "argv": [
        "cargo",
        "test"
      ],
      "names": [
        "API_KEY"
      ],
      "vault": "{{TMP}}/proj/../tools"
    }
  ]
}
