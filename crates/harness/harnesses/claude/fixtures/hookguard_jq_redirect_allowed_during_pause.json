{
  "event": "before_tool",
  "env": {
    "HOME": "{{TMP}}/home",
    "USERPROFILE": "{{TMP}}/home",
    "VAHTA_DATA_DIR": "{{TMP}}/data"
  },
  "files": {
    "home/.claude/settings.json": "{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"Bash|Write|Edit|MultiEdit|mcp__.*\",\"hooks\":[{\"type\":\"command\",\"command\":\"/opt/vahta/vahta-hook --harness claude --event before_tool --setup 2\"}]}],\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"/opt/vahta/vahta-hook --harness claude --event session_start --setup 2\"}]}]},\"permissions\":{\"allow\":[]}}",
    "proj/src/main.rs": "fn main() {}\n",
    "data/pause.json": "{\"pauses\": [{\"harness\": \"claude\", \"until\": 99999999999, \"reason\": \"fixture\", \"kind\": \"edit\"}]}"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "jq 'del(.hooks)' ~/.claude/settings.json > ~/.claude/settings.json"
    },
    "cwd": "{{TMP}}/proj"
  },
  "stdout": null,
  "exit": 0,
  "spool": []
}
