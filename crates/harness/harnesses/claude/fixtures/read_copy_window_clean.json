{
  "event": "before_read",
  "env": {},
  "daemon": {
    "scan": {
      "DB_PASSWORD": "{{SECRET_PW}}"
    }
  },
  "files": {
    "notes.txt": "line one\nthe db password is {{SECRET_PW}} here\nline three\nline four\n"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
      "file_path": "{{TMP}}/notes.txt",
      "offset": 3,
      "limit": 2
    },
    "cwd": "{{TMP}}",
    "session_id": "s1"
  },
  "stdout": null,
  "exit": 0
}
