{
  "event": "before_tool",
  "env": {},
  "files": {
    "proj/vahta.toml": "[secrets.API_KEY]\n"
  },
  "daemon": {
    "check_run": "allowed"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "vh run --secret API_KEY --as API_KEY=TOKEN --label 'run the tests' -- sh -c 'cargo test --lib'"
    },
    "cwd": "{{TMP}}/proj"
  },
  "stdout": {
    "hookSpecificOutput": {
      "hookEventName": "PreToolUse",
      "permissionDecision": "allow",
      "permissionDecisionReason": "Vahta: the command is within API_KEY's approved rules"
    }
  },
  "exit": 0,
  "check_run": [
    {
      "cwd": "{{TMP}}/proj",
      "argv": [
        "sh",
        "-c",
        "cargo test --lib"
      ],
      "names": [
        "API_KEY"
      ]
    }
  ]
}
