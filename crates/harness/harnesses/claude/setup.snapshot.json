{
  "setup_version": 3,
  "fragment": {
    "permissions": {
      "deny": [
        "Bash(vahta reveal:*)",
        "Bash(vahta copy:*)",
        "Bash(vahta _surface:*)",
        "Bash(vh reveal:*)",
        "Bash(vh copy:*)",
        "Bash(vh _surface:*)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event before_tool --setup 3"
            }
          ]
        },
        {
          "matcher": "Read|Grep",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event before_read --setup 3"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event session_start --setup 3"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event prompt --setup 3"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash|Read|Grep|Glob|WebFetch|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event after_tool --setup 3"
            }
          ]
        }
      ]
    }
  }
}
