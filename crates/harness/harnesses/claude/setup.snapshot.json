{
  "setup_version": 4,
  "fragment": {
    "permissions": {
      "deny": [
        "Bash(vahta reveal:*)",
        "Bash(vahta copy:*)",
        "Bash(vahta _surface:*)",
        "Bash(vh reveal:*)",
        "Bash(vh copy:*)",
        "Bash(vh _surface:*)"
      ],
      "allow": [
        "Bash(vahta list)",
        "Bash(vahta list --json)",
        "Bash(vahta check)",
        "Bash(vahta check --json)",
        "Bash(vh list)",
        "Bash(vh list --json)",
        "Bash(vh check)",
        "Bash(vh check --json)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event before_tool --setup 4"
            }
          ]
        },
        {
          "matcher": "Read|Grep",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event before_read --setup 4"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event session_start --setup 4"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event prompt --setup 4"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash|Read|Grep|Glob|WebFetch|mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "{hook} --harness claude --event after_tool --setup 4"
            }
          ]
        }
      ]
    }
  }
}
